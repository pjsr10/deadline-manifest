# Copy this file to .env and fill in the two values from your Supabase
# project's Settings > API page. Both are safe to expose in a browser —
# the anon key only works within whatever Row Level Security policies
# you've set up in Supabase.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
